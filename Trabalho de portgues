        <a href="#referencias">Referências</a>
    </nav>

    <main>

        <!-- 1. QUEM FOI A AUTORA -->

        <section id="autora">

            <div class="numero">01 — A AUTORA</div>

            <h2>Uma voz importante do Parnasianismo</h2>

            <p class="destaque">
                Francisca Júlia da Silva (1871–1920) foi uma poetisa
                brasileira reconhecida pelo cuidado com a linguagem
                e pela construção formal de seus poemas.
            </p>

            <div class="retrato-container">

                <img
                    class="retrato"
