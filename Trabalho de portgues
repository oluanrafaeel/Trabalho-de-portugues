<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Francisca Júlia | Parnasianismo Brasileiro</title>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --preto: #10100e;
            --painel: #1b1a16;
            --dourado: #d6b778;
            --branco: #f5eddf;
            --cinza: #c4bba9;
            --borda: rgba(214, 183, 120, 0.3);
        }

        body {
            background: var(--preto);
            color: var(--branco);
            font-family: "Lora", Georgia, serif;
            line-height: 1.8;
        }

        /* MENU */

        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px 25px;
            padding: 18px;
            background: rgba(16, 16, 14, 0.96);
            border-bottom: 1px solid var(--borda);
            backdrop-filter: blur(10px);
        }

        nav a {
            color: var(--branco);
            text-decoration: none;
            font-size: 13px;
            transition: 0.3s;
        }

        nav a:hover {
            color: var(--dourado);
        }

        /* CAPA */

        header {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 50px 20px;
            background:
                linear-gradient(rgba(10, 10, 8, 0.72), rgba(10, 10, 8, 0.96)),
                url("https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=1800&q=85");
            background-position: center;
            background-size: cover;
        }

        .capa {
            max-width: 900px;
            animation: aparecer 1.2s ease;
        }

        .etiqueta {
            color: var(--dourado);
            letter-spacing: 5px;
            text-transform: uppercase;
            font-size: 12px;
        }

        h1, h2, h3 {
            font-family: "Cormorant Garamond", Georgia, serif;
            line-height: 1.15;
        }

        h1 {
            color: var(--dourado);
            font-size: clamp(55px, 9vw, 110px);
            margin: 20px 0;
            font-weight: 500;
        }

        .subtitulo {
            max-width: 700px;
            margin: auto;
            font-size: 17px;
            color: #e0d7c7;
        }

        .botao {
            display: inline-block;
            margin-top: 35px;
            padding: 13px 28px;
            border: 1px solid var(--dourado);
            color: var(--dourado);
            text-decoration: none;
            letter-spacing: 1px;
            transition: 0.3s;
        }

        .botao:hover {
            background: var(--dourado);
            color: var(--preto);
            transform: translateY(-3px);
        }

        /* CONTEÚDO */

        main {
            width: min(1000px, 90%);
            margin: auto;
        }

        section {
            padding: 90px 0;
            border-bottom: 1px solid var(--borda);
        }

        .numero {
            color: var(--dourado);
            font-size: 12px;
            letter-spacing: 4px;
        }

        h2 {
            color: var(--dourado);
            font-size: clamp(35px, 5vw, 55px);
            margin: 15px 0 30px;
        }

        h3 {
            color: var(--dourado);
            font-size: 26px;
            margin-bottom: 15px;
        }

        p {
            color: var(--cinza);
            margin-bottom: 18px;
        }

        .destaque {
            color: var(--branco);
            font-size: 20px;
        }

        /* RETRATO */

        .retrato-container {
            text-align: center;
            margin: 35px 0;
        }

        .retrato {
            display: block;
            width: 230px;
            max-width: 100%;
            max-height: 320px;
            object-fit: cover;
            margin: auto;
            padding: 7px;
            border: 2px solid var(--dourado);
            border-radius: 5px;
            background: var(--painel);
        }

        .legenda {
            margin-top: 10px;
            font-size: 12px;
        }

        /* CARTÕES */

        .grade {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .cartao {
            padding: 30px;
            background: var(--painel);
            border: 1px solid var(--borda);
            transition: 0.3s;
        }

        .cartao:hover {
            transform: translateY(-5px);
            border-color: var(--dourado);
        }

        .cartao p {
            margin-bottom: 0;
        }

        /* CITAÇÃO */

        .citacao {
            margin: 35px 0;
            padding: 25px 30px;
            border-left: 3px solid var(--dourado);
            background: var(--painel);
            color: var(--branco);
            font-family: "Cormorant Garamond", Georgia, serif;
            font-size: 27px;
        }

        /* CORES */

        .paleta {
            display: flex;
            gap: 15px;
            margin: 25px 0;
        }

        .cor {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            border: 1px solid var(--borda);
        }

        .cor1 { background: #d6b778; }
        .cor2 { background: #10100e; }
        .cor3 { background: #f5eddf; }

        /* REFERÊNCIAS */

        ul {
            padding-left: 25px;
        }

        li {
            color: var(--cinza);
            margin-bottom: 12px;
        }

        li a {
            color: var(--dourado);
        }

        .aviso {
            margin-top: 25px;
            padding: 20px;
            border: 1px dashed var(--borda);
            font-size: 14px;
        }

        /* RODAPÉ */

        footer {
            padding: 45px 20px;
            text-align: center;
            background: #0b0b09;
        }

        footer p {
            font-size: 13px;
        }

        footer a {
            color: var(--dourado);
            text-decoration: none;
        }

        @keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* CELULAR */

        @media (max-width: 650px) {
            nav {
                gap: 10px 15px;
            }

            nav a {
                font-size: 11px;
            }

            header {
                min-height: 75vh;
            }

            .grade {
                grid-template-columns: 1fr;
            }

            section {
                padding: 60px 0;
            }

            .citacao {
                font-size: 22px;
            }
        }
    </style>
</head>

<body>

    <!-- CAPA DO SITE -->

    <header id="inicio">
        <div class="capa">

            <div class="etiqueta">
                Literatura Brasileira • Parnasianismo
            </div>

            <h1>Francisca Júlia</h1>

            <p class="subtitulo">
                Além da estética: a arte dos versos, a busca pela perfeição
                formal e a presença de uma mulher na literatura brasileira.
            </p>

            <a href="#autora" class="botao">
                EXPLORAR TRABALHO ↓
            </a>

        </div>
    </header>

    <!-- MENU DE NAVEGAÇÃO -->

    <nav>
